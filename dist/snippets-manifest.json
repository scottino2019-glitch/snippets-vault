      "code": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: #1e242c;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    }\n    .user-card {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      background: #262e38;\n      border: 1px solid #374353;\n      padding: 16px 20px;\n      border-radius: 12px;\n      min-width: 280px;\n    }\n    .avatar {\n      width: 48px;\n      height: 48px;\n      border-radius: 50%;\n      background: #f59e0b;\n      color: #1e242c;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 700;\n      font-size: 16px;\n    }\n    .info-name {\n      margin: 0;\n      font-size: 15px;\n      color: #e2e8f0;\n      font-weight: 600;\n    }\n    .info-role {\n      margin: 2px 0 0 0;\n      font-size: 12px;\n      color: #94a3b8;\n    }\n    .badge-status {\n      margin-left: auto;\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: #10b981;\n      box-shadow: 0 0 8px #10b981;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"user-card\">\n    <div class=\"avatar\">MR</div>\n    <div>\n      <h4 class=\"info-name\">Marco Rossi</h4>\n      <p class=\"info-role\">Frontend Specialist</p>\n    </div>\n    <div class=\"badge-status\" title=\"Attivo\"></div>\n  </div>\n</body>\n</html>\n"
