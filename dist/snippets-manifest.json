    {
      "filePath": "public/snippets/layout/griglia-moderna.html",
      "category": "layout",
      "title": "Griglia Moderna",
      "code": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body {\n      margin: 0;\n      background: #1e242c;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      padding: 24px;\n      box-sizing: border-box;\n    }\n    .grid-container {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n      gap: 16px;\n      max-width: 800px;\n      margin: 0 auto;\n    }\n    .grid-item {\n      background: #272f3a;\n      border: 1px solid #374353;\n      border-radius: 8px;\n      padding: 20px;\n      text-align: center;\n      color: #cbd5e1;\n      font-size: 14px;\n      font-weight: 500;\n    }\n    .grid-item span {\n      display: block;\n      font-size: 24px;\n      margin-bottom: 8px;\n      color: #6366f1;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"grid-container\">\n    <div class=\"grid-item\">\n      <span>01</span>\n      Layout Flessibile\n    </div>\n    <div class=\"grid-item\">\n      <span>02</span>\n      Auto Responsive\n    </div>\n    <div class=\"grid-item\">\n      <span>03</span>\n      Zero Dipendenze\n    </div>\n    <div class=\"grid-item\">\n      <span>04</span>\n      Grid CSS Moderno\n    </div>\n  </div>\n</body>\n</html>\n"
